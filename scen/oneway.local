W=$(rx writer); N=$(rx "nodeof $W"); RP=$(rx rp); echo "writer=$W node=$N (egress-only block 90 s)"; ssh -n -F ssh_config $N "MODE=out bash partition.sh 90 & bash sbwriter.sh $DBCONT ${CLI:-mysql} '$RP' 55; wait" | awk '{k=$3" "$4" "$5; if(k!=p){print; p=k}}' | cut -c1-160; sleep 120; rx "kubectl -n $NS get pods -o wide | grep -vE 'probe|load|bigprep|sysb'; echo ISOLATED_ROWS_IN_CLUSTER \$(isocount)"

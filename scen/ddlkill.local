W=$(rx writer); N=$(rx "nodeof $W"); echo "writer=$W node=$N: start ALTER on sbbig.sbtest3, kill -9 after 60 s"
rx "kubectl -n $NS exec $W -c $DBCONT -- bash -c \"${CLI:-mysql} -uroot -p'\$(rp)' -e 'alter table sbbig.sbtest3 add column ddlkill int default 0, algorithm=inplace, lock=none' >/dev/null 2>&1 &\""; sleep 60; echo "KILL $(date +%s%3N)"
ssh -n -F ssh_config $N 'pkill -9 -x mysqld; pkill -9 -x mariadbd'; sleep ${S:-300}; rx "kubectl -n $NS wait --for=condition=Ready pod -l $DBSEL --timeout=1200s >/dev/null 2>&1; for p in \$(kubectl -n $NS get pods -l $DBSEL -o name | cut -d/ -f2); do echo \$p cols=\$(sql \$p $DBCONT \"select count(*) from information_schema.columns where table_schema='sbbig' and table_name='sbtest3' and column_name='ddlkill'\"); done"

# perf: sysbench oltp_read_write on 4 x 1M rows (sbtest), 16 and 64 threads, 300 s each, via $PERF_PROXY and $PERF_DIRECT
for tgt in proxy:$PERF_PROXY direct:$PERF_DIRECT; do for th in 16 64; do
 rx "kubectl -n $NS delete pod perf --ignore-not-found --wait=true >/dev/null; kubectl -n $NS run perf --restart=Never --image=perconalab/sysbench:latest --overrides='{\"spec\":{\"nodeSelector\":{\"kubernetes.io/hostname\":\"'\$(hostname)'\"},\"tolerations\":[{\"key\":\"node-role.kubernetes.io/control-plane\",\"operator\":\"Exists\",\"effect\":\"NoSchedule\"}]}}' --command -- sysbench oltp_read_write --mysql-host=${tgt#*:} --mysql-user=sb --mysql-password=SbPass123 --mysql-db=sbtest --tables=4 --table-size=1000000 --threads=$th --time=300 --report-interval=60 --db-ps-mode=disable $PERF_EXTRA run >/dev/null; kubectl -n $NS wait --for=jsonpath='{.status.phase}'=Succeeded pod/perf --timeout=600s >/dev/null; echo \"PERF ${tgt%%:*} threads=$th \$(kubectl -n $NS logs perf | grep -E 'transactions:|95th percentile:' | tr -s ' ' | tr '\n' ' ')\""
done; done
